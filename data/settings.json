{
  "theme": {
    "primaryColor": "#3b82f6",
    "darkMode": true,
    "fontSize": "medium"
  },
  "weather": {
    "defaultLocationName": "Marmaris",
    "defaultLatitude": 36.8529,
    "defaultLongitude": 28.2742
  },
  "sync": {
    "enabled": true,
