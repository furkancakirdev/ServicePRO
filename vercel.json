{
  "version": 2,
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 3 * * *"
    }
  ],
  "functions": {
    "app/api/cron/sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/sync/route.ts": {
      "maxDuration": 300
    },
    "app/api/sync/full-reset/route.ts": {
      "maxDuration": 300
    },
    "app/api/sync/validate/route.ts": {
      "maxDuration": 300
    }
  }
}
